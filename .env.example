# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal -> your app -> General Information)
DISCORD_CLIENT_ID=

# Optional: your league's server ID. When set, `npm run register` registers
# commands to this guild only (instant). Without it, commands register
# globally (can take up to an hour to appear).
GUILD_ID=

# Optional: where guild config JSON is stored (default: ./data)
DATA_DIR=

# Optional: if set, a tiny HTTP health server listens on this port.
# Needed on hosts like Render/Koyeb that require an open HTTP port.
PORT=
